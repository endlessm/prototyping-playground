    {
      "backgroundColor": "#fff3bf",
      "boundElements": [
        {
          "id": "text-00332",
          "type": "text"
        }
      ],
      "height": 1077.5,
      "id": "rectangle-00331",
      "index": "b4K",
      "roughness": 0,
      "roundness": {
        "type": 3
      },
      "seed": 1903794124,
      "strokeColor": "#f08c00",
