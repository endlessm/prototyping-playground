{
  "name": "design-studio",
  "description": "Endless Design Studio, a prototyping sandbox for the Endless team",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "workspaces": [
    "src/systems/*"
  ],
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "build:full": "yarn test:full && yarn build",
    "build:inspect": "node tooling/inspect-build.ts",
    "preview": "node tooling/serve-static.ts",
    "studio": "node tooling/studio/cli.ts",
    "check": "node tooling/checks/run.ts modules",
    "check:scope": "node tooling/checks/run.ts scope",
    "check:assets": "node tooling/checks/run.ts assets",
    "new": "node tooling/studio/cli.ts new",
    "postinstall": "node tooling/check-node.ts && husky && nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:full": "vitest run",
    "test:watch": "vitest",
    "parity": "vitest run --config vitest.parity.config.ts",
    "parity:coverage": "node tooling/parity/coverage.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "patch:@excalidraw/excalidraw@npm%3A0.18.1#~/.yarn/patches/@excalidraw-excalidraw-npm-0.18.1.patch",
    "@fontsource/comic-neue": "^5.2.7",
    "@iconify-json/lucide": "^1.2.145",
    "@lezer/highlight": "^1.2.5",
    "@nuxt/ui": "~4.8.2",
    "@nuxtjs/i18n": "^10.3.0",
    "@nuxtjs/mdc": "^0.23.2",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "codemirror-lang-mermaid": "^0.5.0",
    "marked": "^17.0.1",
    "mermaid": "^12.2.0",
    "nuxt": "^4.4.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.11",
    "trash": "^10.1.1",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.4.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.61.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.7"
  },
  "lint-staged": {
    "**/*.{js,mjs,ts,vue,css}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
