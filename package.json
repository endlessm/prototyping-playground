{
  "name": "design-studio",
  "description": "Endless Design Studio, a prototyping sandbox for the Endless team",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "workspaces": [
    "src/systems/*"
  ],
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "build:full": "yarn test:full && yarn build",
    "build:inspect": "node tooling/inspect-build.ts",
    "preview": "node tooling/serve-static.ts",
    "studio": "node tooling/studio/cli.ts",
    "postinstall": "node tooling/check-node.ts && husky && nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:full": "vitest run",
    "test:watch": "vitest",
    "parity": "vitest run --config vitest.parity.config.ts",
    "parity:coverage": "node tooling/parity/coverage.ts"
  },
  "dependencies": {
    "@fontsource/comic-neue": "^5.2.7",
    "@iconify-json/lucide": "^1.2.145",
    "@nuxt/ui": "~4.8.2",
    "@nuxtjs/i18n": "^10.3.0",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "nuxt": "^4.4.8",
    "tailwindcss": "^4.1.11",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.4.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.61.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.7",
    "yaml": "^2.8.0"
  },
  "lint-staged": {
    "**/*.{js,mjs,ts,vue,css}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
