{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Endless Prototyping Playground configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "name",
    "modules",
    "systems",
    "systemMaintainers",
    "defaultSystem",
    "admins"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Studio name; required."
    },
    "tagline": {
      "type": "string",
      "maxLength": 140,
      "description": "Optional line on the published Home."
    },
    "modules": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "description": "Every installed module explicitly on or off. Required modules stay on."
    },
    "systems": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Registered system folder keys."
    },
    "defaultSystem": {
      "type": ["string", "null"],
      "description": "Active system permanent ID, or null. Existing prototypes keep their explicit assignment."
    },
    "admins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{16}$" },
      "description": "Registered contributors' permanent IDs; at least one Admin."
    },
    "systemMaintainers": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{16}$" }
      },
      "description": "System permanent IDs mapped to registered contributor IDs; [] means unassigned."
    }
  }
}
